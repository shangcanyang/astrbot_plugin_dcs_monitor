{
    "api_base": {
        "type": "string",
        "title": "DCS API 基础地址",
        "default": "http://119.36.147.45:8041"
    },
    "username": {
        "type": "string",
        "title": "登录用户名",
        "default": "J21137"
    },
    "password": {
        "type": "string",
        "title": "登录密码",
        "default": "Cxfpass@123",
        "format": "password"
    },
    "client_id": {
        "type": "string",
        "title": "客户端ID",
        "default": "ms-content-sample"
    },
    "point_prefix": {
        "type": "string",
        "title": "点ID前缀",
        "default": "system:LinkObject:serverdata1:system:",
        "description": "自动拼接到每个点位名称前面的固定前缀。"
    },
    "default_check_interval": {
        "type": "int",
        "title": "全局默认检查间隔(秒)",
        "default": 10
    },
    "points": {
        "type": "list",
        "title": "监控点位列表",
        "description": "只需要填写点位名称（例如 HCY_709B101_PV），上下限为可选，留空则不预警。",
        "items": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "title": "点位名称",
                    "description": "例如 HCY_709B101_PV 或 HCY_FICOMP_710B101_PV"
                },
                "description": {
                    "type": "string",
                    "title": "点位描述（可选）",
                    "description": "用于预警消息中显示，便于识别，不填则使用名称。"
                },
                "low_threshold": {
                    "type": "number",
                    "title": "低阈值（可选）",
                    "description": "低于此值触发预警。"
                },
                "high_threshold": {
                    "type": "number",
                    "title": "高阈值（可选）",
                    "description": "高于此值触发预警。"
                },
                "check_interval": {
                    "type": "int",
                    "title": "检查间隔(秒)",
                    "description": "覆盖全局默认间隔，不填则使用全局默认值。"
                },
                "enabled": {
                    "type": "boolean",
                    "title": "启用此点位",
                    "default": true
                }
            },
            "required": ["name"]
        }
    }
}