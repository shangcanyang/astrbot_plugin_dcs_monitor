{
  "type": "object",
  "properties": {
    "api_base": {
      "type": "string",
      "title": "DCS API 基础地址",
      "default": "http://119.36.147.45:8041",
      "description": "例如 http://your-dcs-server:8041"
    },
    "username": {
      "type": "string",
      "title": "登录用户名",
      "default": "J21137"
    },
    "password": {
      "type": "string",
      "title": "登录密码",
      "default": "Cxfpass@123",
      "format": "password"
    },
    "client_id": {
      "type": "string",
      "title": "客户端ID",
      "default": "ms-content-sample"
    },
    "point_prefix": {
      "type": "string",
      "title": "点ID前缀",
      "default": "system:LinkObject:serverdata1:system:"
    },
    "point_name": {
      "type": "string",
      "title": "监控点名称",
      "default": "HCY_FICOMP_710B101_PV",
      "description": "例如 HCY_FICOMP_709A101_PV"
    },
    "check_interval": {
      "type": "integer",
      "title": "检查间隔(秒)",
      "default": 10,
      "minimum": 2,
      "maximum": 300
    },
    "low_threshold": {
      "type": "number",
      "title": "低阈值（可选）",
      "default": null,
      "description": "低于此值触发预警，不填则不启用"
    },
    "high_threshold": {
      "type": "number",
      "title": "高阈值（可选）",
      "default": null,
      "description": "高于此值触发预警，不填则不启用"
    }
  },
  "required": ["username", "password", "point_name"]
}